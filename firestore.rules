rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザープロフィールのルール
    match /users/{userId} {
      // 自分のデータは読み書き自由
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 他人のデータは「フレンド検索」と「リスト表示」のために一部読み取りを許可
      // 検索（query）できるようにするには 'list' または 'read' が必要
      allow read: if request.auth != null;
    }

    // フレンド申請のルール
    match /friendRequests/{requestId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
    }

    // チャットメッセージのルール
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null; // 簡略化のため。本来は参加者のみに制限すべき
    }
    
    // 保存データのルール
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 目安箱
    match /suggestions/{docId} {
      allow create: if true;
      allow read: if false; // 管理者のみ想定
    }
  }
}
